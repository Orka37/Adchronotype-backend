# Local development only. Replace the password and signing secret.
DATABASE_URL=postgresql+psycopg2://adc:adc_local@localhost:5432/adchronotype
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:8081
FRONTEND_APP_URL=http://localhost:8081
RUN_MIGRATIONS_ON_STARTUP=false
GOOGLE_WEB_CLIENT_ID=
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=
# Optional V2 artifact; blank uses adchronotype_xgboost_v2.json in repository root.
SIMILARITY_MODEL_PATH=
